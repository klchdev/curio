STEAM_API_KEY=your_steam_api_key_here
SESSION_SECRET=random_secret_at_least_32_chars
DATABASE_URL=postgresql://user:pass@host:5432/db

# Encrypts users' model keys. 32 bytes in base64:
#   openssl rand -base64 32
# Lose this key and the stored user keys become undecryptable,
# and everyone will have to enter theirs again.
ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# Password for /api/cron/poll. Without it the playtime tracker doesn't start
CRON_SECRET=random_secret_at_least_32_chars

# Instance owner's test accounts: signing in as an arbitrary user.
# Off by default; turn it on in production only deliberately.
DEV_ACCOUNTS_ENABLED=false
# Who is allowed to — SteamIDs, comma-separated. Empty means "nobody".
DEV_STEAM_IDS=
