STEAM_API_KEY=your_steam_api_key_here
SESSION_SECRET=random_secret_at_least_32_chars
DATABASE_URL=postgresql://user:pass@host:5432/db
GEMINI_API_KEY=your_gemini_api_key_here
# Необязательный: на него уходят запросы, когда бесплатный ключ упирается в частоту
GEMINI_API_KEY_PAID=your_paid_gemini_api_key_here
# Пароль к /api/cron/poll. Без него трекер наигранного времени не запускается
CRON_SECRET=random_secret_at_least_32_chars
