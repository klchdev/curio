---
import Layout from "../layouts/Layout.astro";

const TIERS = [
  { value: "S", label: "S", hint: "Шедевр",   bg: "bg-yellow-500", text: "text-yellow-950", count: 3,  rec: [5, 10]  },
  { value: "A", label: "A", hint: "Крутая",   bg: "bg-emerald-500", text: "text-emerald-950", count: 5, rec: [15, 25] },
  { value: "B", label: "B", hint: "Хорошая",  bg: "bg-sky-500",     text: "text-sky-950",     count: 6, rec: [25, 35] },
  { value: "C", label: "C", hint: "Сойдёт",   bg: "bg-orange-500",  text: "text-orange-950",  count: 4, rec: [15, 25] },
  { value: "D", label: "D", hint: "Не зашло", bg: "bg-red-500",     text: "text-red-950",     count: 1, rec: [10, 20] },
  { value: "F", label: "F", hint: "Провал",   bg: "bg-rose-800",    text: "text-rose-100",    count: 1, rec: [5, 10]  },
];

const total = TIERS.reduce((s, t) => s + t.count, 0);
const withPct = TIERS.map(t => ({
  ...t,
  pct: Math.round(t.count / total * 100),
  over: Math.round(t.count / total * 100) > t.rec[1],
  under: Math.round(t.count / total * 100) < t.rec[0],
}));
---

<Layout title="Демо: распределение тиров">
  <div class="mb-6 flex items-center gap-4">
    <a href="/tier-list" class="text-sm text-gray-400 hover:text-white">&larr; Назад</a>
    <h1 class="text-xl font-bold">Демо: варианты отображения распределения</h1>
  </div>
  <p class="mb-8 text-sm text-gray-500">Фейковые данные: 20 игр. S перегружен (15% при рекомендуемых 5–10%).</p>

  <!-- ВАРИАНТ 1: % в ячейке тира -->
  <section class="mb-12">
    <h2 class="mb-3 text-lg font-semibold">Вариант 1 — % в ячейке тира</h2>
    <div class="space-y-1">
      {withPct.map(t => (
        <div class="flex min-h-[88px] rounded-lg border border-gray-800 bg-gray-900">
          <div class={`flex w-20 flex-shrink-0 flex-col items-center justify-center rounded-l-lg ${t.bg}`}>
            <span class={`text-3xl font-black leading-none ${t.text}`}>{t.label}</span>
            <span class={`mt-0.5 text-[9px] font-medium opacity-70 ${t.text}`}>{t.hint}</span>
            <span class={`mt-1 text-[10px] font-bold ${t.over ? "text-red-200" : t.under ? "text-white/50" : "text-white/80"}`}>
              {t.pct}%
              {t.over && <span> ↑</span>}
            </span>
            <span class={`text-[8px] opacity-60 ${t.text}`}>рек. {t.rec[0]}–{t.rec[1]}%</span>
          </div>
          <div class="flex flex-1 items-center gap-2 p-3">
            {Array.from({ length: t.count }).map((_, i) => (
              <div class="h-16 w-[120px] rounded bg-gray-700 opacity-60" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ВАРИАНТ 2: бар-чарт сверху -->
  <section class="mb-12">
    <h2 class="mb-3 text-lg font-semibold">Вариант 2 — бар-чарт сверху</h2>

    <div class="mb-4 rounded-lg border border-gray-800 bg-gray-900 p-4">
      <div class="mb-2 flex items-center justify-between text-xs text-gray-500">
        <span>Распределение игр</span>
        <span>{total} игр</span>
      </div>

      <!-- Текущее -->
      <div class="mb-1">
        <span class="mb-1 block text-[10px] text-gray-500">Текущее</span>
        <div class="flex h-6 w-full overflow-hidden rounded">
          {withPct.map(t => (
            <div
              class={`flex items-center justify-center text-[9px] font-bold transition-all ${t.bg} ${t.text}`}
              style={`width: ${t.pct}%`}
              title={`${t.label}: ${t.pct}%`}
            >
              {t.pct >= 8 ? `${t.label} ${t.pct}%` : t.pct >= 5 ? t.label : ""}
            </div>
          ))}
        </div>
      </div>

      <!-- Рекомендуемое -->
      <div class="mb-3">
        <span class="mb-1 block text-[10px] text-gray-500">Рекомендуемое</span>
        <div class="flex h-3 w-full overflow-hidden rounded opacity-40">
          {withPct.map(t => (
            <div
              class={`${t.bg}`}
              style={`width: ${(t.rec[0] + t.rec[1]) / 2}%`}
            />
          ))}
        </div>
      </div>

      <!-- Легенда -->
      <div class="flex flex-wrap gap-x-4 gap-y-1">
        {withPct.map(t => (
          <div class="flex items-center gap-1.5 text-xs">
            <div class={`h-2.5 w-2.5 rounded-sm ${t.bg}`} />
            <span class={t.over ? "text-red-400 font-medium" : "text-gray-400"}>
              {t.label} {t.pct}%{t.over ? " ↑" : ""}
            </span>
          </div>
        ))}
      </div>
    </div>

    <div class="space-y-1">
      {withPct.map(t => (
        <div class="flex min-h-[88px] rounded-lg border border-gray-800 bg-gray-900">
          <div class={`flex w-16 flex-shrink-0 flex-col items-center justify-center rounded-l-lg ${t.bg}`}>
            <span class={`text-3xl font-black leading-none ${t.text}`}>{t.label}</span>
            <span class={`mt-0.5 text-[9px] font-medium opacity-70 ${t.text}`}>{t.hint}</span>
          </div>
          <div class="flex flex-1 items-center gap-2 p-3">
            {Array.from({ length: t.count }).map(() => (
              <div class="h-16 w-[120px] rounded bg-gray-700 opacity-60" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ВАРИАНТ 3: тонкий индикатор под каждым тиром -->
  <section class="mb-12">
    <h2 class="mb-3 text-lg font-semibold">Вариант 3 — полоска под каждым тиром</h2>
    <div class="space-y-1">
      {withPct.map(t => (
        <div>
          <div class="flex min-h-[88px] rounded-t-lg border border-b-0 border-gray-800 bg-gray-900">
            <div class={`flex w-16 flex-shrink-0 flex-col items-center justify-center rounded-tl-lg ${t.bg}`}>
              <span class={`text-3xl font-black leading-none ${t.text}`}>{t.label}</span>
              <span class={`mt-0.5 text-[9px] font-medium opacity-70 ${t.text}`}>{t.hint}</span>
            </div>
            <div class="flex flex-1 items-center gap-2 p-3">
              {Array.from({ length: t.count }).map(() => (
                <div class="h-16 w-[120px] rounded bg-gray-700 opacity-60" />
              ))}
            </div>
          </div>
          <!-- Индикатор -->
          <div class="relative h-1.5 w-full overflow-visible rounded-b-lg bg-gray-800">
            <!-- Заливка текущего % -->
            <div
              class={`h-full rounded-bl-lg transition-all ${t.over ? "bg-red-500" : t.under ? "bg-gray-600" : "bg-emerald-600"}`}
              style={`width: ${Math.min(t.pct, 100)}%`}
            />
            <!-- Маркер рекомендуемого максимума -->
            <div
              class="absolute top-0 h-full w-0.5 bg-white/40"
              style={`left: ${t.rec[1]}%`}
              title={`Рекомендуемый макс. ${t.rec[1]}%`}
            />
          </div>
        </div>
      ))}
    </div>
    <p class="mt-2 text-xs text-gray-600">
      Зелёный = норм · Красный = перебор · Белая черта = рекомендуемый максимум
    </p>
  </section>
</Layout>
