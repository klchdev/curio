---
import Layout from "../layouts/Layout.astro";
import { getSessionUser } from "../lib/session";
import { getStats } from "../lib/queries";

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect("/");

const stats = await getStats(user.id);

const alreadyPlayed = stats.totalLibrary - stats.poolSize - stats.excludedCount;
const progressPercent = stats.poolSize > 0
  ? Math.round((stats.totalGames / (stats.totalGames + stats.poolSize)) * 100)
  : 0;

function formatTime(minutes: number) {
  if (minutes >= 60) {
    const h = Math.floor(minutes / 60);
    const m = minutes % 60;
    return m > 0 ? `${h} ч ${m} мин` : `${h} ч`;
  }
  return `${minutes} мин`;
}
---

<Layout title="Профиль">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-4">
      {user.avatarUrl && (
        <img src={user.avatarUrl} alt="" class="h-16 w-16 rounded-full" />
      )}
      <h1 class="text-2xl font-bold">{user.username}</h1>
    </div>
    <a href="/dashboard" class="text-sm text-gray-400 transition hover:text-white">&larr; Назад</a>
  </div>

  <!-- Backlog Progress -->
  <section class="mb-8">
    <h2 class="mb-4 text-lg font-semibold">Прогресс бэклога</h2>
    <div class="rounded-xl border border-gray-800 bg-gray-900 p-6">
      <div class="mb-4 flex items-end justify-between">
        <div>
          <span class="text-4xl font-bold text-indigo-400">{stats.totalGames}</span>
          <span class="text-lg text-gray-400"> / {stats.totalGames + stats.poolSize}</span>
        </div>
        <span class="text-sm text-gray-500">{progressPercent}% пула пройдено</span>
      </div>
      <div class="mb-3 h-3 w-full overflow-hidden rounded-full bg-gray-800">
        <div
          class="h-full rounded-full bg-gradient-to-r from-indigo-600 to-indigo-400 transition-all duration-500"
          style={`width: ${Math.max(progressPercent, 1)}%`}
        />
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-400">
        <span>В пуле рулетки: <strong class="text-gray-200">{stats.poolSize}</strong></span>
        <span>Активные слоты: <strong class="text-gray-200">{stats.activeCount}/3</strong></span>
        <span>Уже играл (&gt;15 мин): <strong class="text-gray-200">{alreadyPlayed}</strong></span>
        {stats.excludedCount > 0 && (
          <span>Исключено: <strong class="text-gray-200">{stats.excludedCount}</strong></span>
        )}
      </div>
    </div>
  </section>

  <!-- Stats Grid -->
  <section class="mb-8">
    <h2 class="mb-4 text-lg font-semibold">Статистика</h2>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-6 text-center">
        <div class="text-3xl font-bold text-indigo-400">{stats.totalGames}</div>
        <div class="mt-1 text-sm text-gray-400">Оценено игр</div>
      </div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-6 text-center">
        <div class="text-3xl font-bold text-indigo-400">{formatTime(stats.totalMinutes)}</div>
        <div class="mt-1 text-sm text-gray-400">Суммарное время</div>
      </div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-6 text-center">
        <div class="text-3xl font-bold text-indigo-400">{formatTime(stats.avgMinutes)}</div>
        <div class="mt-1 text-sm text-gray-400">Среднее на игру</div>
      </div>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-6 text-center">
        <div class="text-3xl font-bold text-amber-400">{stats.avgRating}</div>
        <div class="mt-1 text-sm text-gray-400">Средняя оценка</div>
      </div>
    </div>
  </section>

  <!-- Verdict Breakdown -->
  {stats.totalGames > 0 && (
    <section class="mb-8">
      <h2 class="mb-4 text-lg font-semibold">Вердикты</h2>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-xl border border-emerald-900/50 bg-emerald-950/20 p-5 text-center">
          <div class="text-3xl font-bold text-emerald-400">{stats.finishedCount}</div>
          <div class="mt-1 text-sm text-emerald-400/70">Прошёл</div>
        </div>
        <div class="rounded-xl border border-indigo-900/50 bg-indigo-950/20 p-5 text-center">
          <div class="text-3xl font-bold text-indigo-400">{stats.playingCount}</div>
          <div class="mt-1 text-sm text-indigo-400/70">Продолжаю</div>
        </div>
        <div class="rounded-xl border border-red-900/50 bg-red-950/20 p-5 text-center">
          <div class="text-3xl font-bold text-red-400">{stats.droppedCount}</div>
          <div class="mt-1 text-sm text-red-400/70">Бросил</div>
        </div>
        <div class="rounded-xl border border-amber-900/50 bg-amber-950/20 p-5 text-center">
          <div class="text-3xl font-bold text-amber-400">{stats.laterCount}</div>
          <div class="mt-1 text-sm text-amber-400/70">Вернусь позже</div>
        </div>
      </div>
    </section>
  )}

  <!-- Streak -->
  <section class="mb-8">
    <div class="rounded-xl border border-gray-800 bg-gray-900 p-6 text-center">
      <div class="text-3xl font-bold text-green-400">{stats.streak}</div>
      <div class="mt-1 text-sm text-gray-400">Стрик (недель без стыда)</div>
    </div>
  </section>

  <!-- Wall of Shame -->
  {stats.wallOfShame.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-4 text-xl font-semibold text-red-400">Стена стыда</h2>
      <div class="rounded-xl border border-red-900/50 bg-red-950/20 p-4">
        <ul class="space-y-1">
          {stats.wallOfShame.map((title) => (
            <li class="text-gray-300">• {title}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {stats.wallOfShame.length === 0 && stats.totalGames > 0 && (
    <div class="rounded-xl border border-green-900/50 bg-green-950/20 p-6 text-center">
      <span class="text-3xl">🏆</span>
      <p class="mt-2 text-green-400">Чистая совесть! Ни одного позорного скипа.</p>
    </div>
  )}
</Layout>
