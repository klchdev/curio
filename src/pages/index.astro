---
import Layout from "../layouts/Layout.astro";
import AnalyticsOptOut from "../components/AnalyticsOptOut.astro";
import { getSessionUser } from "../lib/session";
import { localeFrom } from "../lib/i18n";
import { t } from "../lib/strings";
import { demoFixtures } from "../lib/demo-fixtures";
import { TIER_STYLE } from "../lib/vocab";

const user = await getSessionUser(Astro);
if (user) return Astro.redirect("/dashboard");

// Sign-in may have failed: this used to silently bounce back to the home page with no explanation
const authFailed = Astro.url.searchParams.get("error") === "auth_failed";

const locale = localeFrom(Astro.cookies, Astro.request);
const s = t(locale);

const GITHUB_URL = "https://github.com/klchdev/curio";
const SPONSOR_URL = "https://github.com/sponsors/klchdev";

/*
 * A second door for the same donation. GitHub Sponsors cannot take a card from
 * a good part of the audience this is written for, and a support link that a
 * reader cannot actually use is worse than none — it reads as a lock rather
 * than an offer.
 */
const BOOSTY_URL = "https://boosty.to/klchdev";

/*
 * The three steps are literally the order a newcomer does things in, not a set
 * of abstract virtues: key, reviews, analysis. Lying here is expensive — on the
 * very first screen after signing in they run into exactly this order.
 */
const STEPS = [
  { title: s.landing.step1Title, text: s.landing.step1Text },
  { title: s.landing.step2Title, text: s.landing.step2Text },
  { title: s.landing.step3Title, text: s.landing.step3Text },
];

/*
 * The strip above the headline.
 *
 * Three covers on their own only said "this is about games", which the headline
 * says better. What the product actually does to a game is put a letter on it,
 * so the letter comes along: same `TIER_STYLE` the app stamps on a shelf, same
 * fixtures, and each cover keeps the tier that was really written about it. A
 * badge is one glyph — it reads before the headline instead of competing with
 * it, and it is the one thing a stranger needs to guess what is on offer here.
 *
 * Fixture data throughout: a real person's shelf has no business on a public
 * page. The four are taken from across the range on purpose — a wall of S would
 * say the advisor likes everything.
 */
const shelfSource = demoFixtures(locale).tierList;

const SHELF = ["S", "A", "C", "D"]
  .map((tier) => shelfSource.find((game) => game.tier === tier))
  .filter((game) => game !== undefined)
  .map((game, index, all) => {
    const offset = index - (all.length - 1) / 2;
    return {
      image: game.gameImage,
      title: game.gameTitle,
      tier: game.tier as keyof typeof TIER_STYLE,
      rotate: offset * 6,
      // Squared so the outer ones dip evenly and the row reads as a curve
      drop: offset * offset * 10,
    };
  });

const FEATURES = [
  { title: s.landing.featureDiary, text: s.landing.featureDiaryText },
  { title: s.landing.featurePicks, text: s.landing.featurePicksText },
  { title: s.landing.featureDeep, text: s.landing.featureDeepText },
  { title: s.landing.featureTiers, text: s.landing.featureTiersText },
  { title: s.landing.featureChrono, text: s.landing.featureChronoText },
  { title: s.landing.featureDemos, text: s.landing.featureDemosText },
];
---

<Layout title={s.meta.homeTitle}>
  <!-- The same atmosphere as inside the app: a glow that fades toward the edges -->
  <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
    <div
      class="absolute top-[18%] left-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-emerald-500 opacity-[0.12] blur-[150px]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-3xl py-16 sm:py-24">
    {authFailed && (
      <p class="reveal mb-8 rounded-xl border border-red-900 bg-red-950/40 px-4 py-3 text-sm text-red-300">
        {s.landing.authFailed}
      </p>
    )}

    <p class="reveal mb-6 text-sm tracking-[0.2em] text-gray-500 uppercase">
      Curio
    </p>

    <!-- aria-hidden with empty alts: ornament for the eye, and a screen reader
         reciting four game names and four letters ahead of the headline would
         bury the sentence that actually explains the product -->
    <div class="reveal mb-6 flex items-start sm:mb-8" aria-hidden="true">
      {SHELF.map((game, index) => (
        <div
          class={`arc-card relative ${index > 0 ? "-ml-6 sm:-ml-8" : ""}`}
          style={`--rot: ${game.rotate}deg; --drop: ${game.drop}px`}
        >
          <img
            src={game.image}
            alt=""
            width="460"
            height="215"
            class="w-24 rounded-lg border border-gray-800 bg-gray-900 shadow-xl shadow-black/50 sm:w-32"
          />
          <span
            class={`absolute -top-2 -left-2 flex h-7 w-7 items-center justify-center rounded-full text-sm font-bold shadow-lg shadow-black/50 sm:h-8 sm:w-8 ${TIER_STYLE[game.tier].bg} ${TIER_STYLE[game.tier].text}`}
          >
            {game.tier}
          </span>
        </div>
      ))}
    </div>

    <h1 class="reveal reveal-1 mb-6 text-5xl leading-[1.05] font-bold text-balance sm:text-6xl">
      {s.landing.heroTop}<br />
      <span class="text-emerald-400">{s.landing.heroAccent}</span>
    </h1>

    <p class="reveal reveal-2 mb-10 max-w-xl text-lg leading-relaxed text-gray-400">
      {s.landing.lede}
    </p>

    <div class="reveal reveal-3 mb-20">
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/auth/login"
          class="rounded-xl bg-white px-7 py-3.5 font-medium text-gray-950 transition hover:scale-[1.02]"
        >
          {s.landing.login}
        </a>
        <a
          href="/try"
          class="rounded-xl border border-emerald-700/70 px-7 py-3.5 font-medium text-emerald-300 transition hover:border-emerald-500 hover:bg-emerald-500/10"
        >
          {s.landing.demoCta}
        </a>
      </div>
      <p class="mt-3 text-xs text-gray-600">
        {s.landing.loginHint} · {s.landing.demoHint}
      </p>

      <!--
        Licence and source belong on the first screen, not in the footer: they are
        what somebody checks before deciding whether this is usable at all. Kept to
        one muted line so it stays an answer, not a banner.
      -->
      <p class="mt-5 text-xs text-gray-500">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noreferrer noopener"
          class="underline decoration-gray-700 underline-offset-4 transition hover:text-gray-300 hover:decoration-gray-500"
        >
          {s.landing.openSource}
        </a>
      </p>
    </div>

    <section class="reveal reveal-4 mb-20">
      <h2 class="mb-6 text-sm tracking-[0.2em] text-gray-500 uppercase">{s.landing.howTitle}</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        {STEPS.map((step, index) => (
          <div class="border-t border-gray-800 pt-4">
            <span class="mb-2 block text-xs text-emerald-500/80">{index + 1}</span>
            <h3 class="mb-2 font-medium">{step.title}</h3>
            <p class="text-sm leading-relaxed text-gray-500">{step.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="reveal reveal-5 mb-20">
      <h2 class="mb-6 text-sm tracking-[0.2em] text-gray-500 uppercase">
        {s.landing.featuresTitle}
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {FEATURES.map((feature) => (
          <div class="rounded-2xl border border-gray-800 bg-gray-900/40 p-5">
            <h3 class="mb-1.5 font-medium">{feature.title}</h3>
            <p class="text-sm leading-relaxed text-gray-500">{feature.text}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- The main question about a free service is "where's the catch": answer it before it's asked -->
    <section class="reveal reveal-6 mb-20 rounded-2xl border border-emerald-800/50 bg-emerald-950/20 p-6">
      <h2 class="mb-2 text-lg font-semibold text-emerald-300">{s.landing.freeTitle}</h2>
      <p class="text-sm leading-relaxed text-gray-300">{s.landing.freeText}</p>
    </section>

    <!--
      Muted on purpose: the page has one call to action and it is "sign in with
      Steam". This one only has to be findable by somebody already looking for it.
    -->
    <section class="reveal reveal-6 mb-20 rounded-2xl border border-gray-800 bg-gray-900/40 p-6">
      <h2 class="mb-2 text-lg font-semibold text-gray-200">{s.landing.sponsorTitle}</h2>
      <p class="mb-5 text-sm leading-relaxed text-gray-400">{s.landing.sponsorText}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href={SPONSOR_URL}
          target="_blank"
          rel="noreferrer noopener"
          class="inline-block rounded-xl border border-gray-700 px-5 py-2.5 text-sm text-gray-300 transition hover:border-gray-500 hover:text-white"
        >
          {s.landing.sponsorCta} ↗
        </a>
        <a
          href={BOOSTY_URL}
          target="_blank"
          rel="noreferrer noopener"
          class="inline-block rounded-xl border border-gray-700 px-5 py-2.5 text-sm text-gray-300 transition hover:border-gray-500 hover:text-white"
        >
          {s.landing.sponsorCtaBoosty} ↗
        </a>
      </div>
    </section>

    <footer class="reveal reveal-6 border-t border-gray-800 pt-6 text-xs leading-relaxed text-gray-600">
      <div class="mb-3 flex flex-wrap gap-x-5 gap-y-1">
        <a
          href={GITHUB_URL}
          target="_blank"
          rel="noreferrer noopener"
          class="transition hover:text-gray-300"
        >
          {s.landing.footerGithub} ↗
        </a>
        <a
          href={SPONSOR_URL}
          target="_blank"
          rel="noreferrer noopener"
          class="transition hover:text-gray-300"
        >
          {s.landing.footerSponsor} ↗
        </a>
      </div>
      <p>{s.landing.footerDisclaimer}</p>
      <!--
        This is the page the counter actually runs on, so the switch belongs
        here too: a guest has no settings page to find it in.
      -->
      <AnalyticsOptOut class="mt-3 text-gray-600" />
    </footer>
  </div>
</Layout>

<style>
  /* The same cascade as in the app, but without React — CSS is enough for this page */
  .reveal {
    animation: rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .reveal-1 { animation-delay: 0.06s; }
  .reveal-2 { animation-delay: 0.14s; }
  .reveal-3 { animation-delay: 0.22s; }
  .reveal-4 { animation-delay: 0.34s; }
  .reveal-5 { animation-delay: 0.42s; }
  .reveal-6 { animation-delay: 0.5s; }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
      filter: blur(2px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
    }
  }
</style>
