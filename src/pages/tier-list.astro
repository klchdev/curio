---
import Layout from "../layouts/Layout.astro";
import { getSessionUser } from "../lib/session";
import { getTierList } from "../lib/queries";
import TierList from "../components/TierList";

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect("/");

// Источник отзыва стал невидимой деталью хранения: одна запись на игру,
// поэтому ни слияния, ни фильтра «рулетка / ретроспектива» больше нет.
const games = (await getTierList(user.id)).map((game) => ({
  slotId: game.gameId,
  gameId: game.gameId,
  gameTitle: game.gameTitle,
  gameImage: game.gameImage,
  steamAppId: game.steamAppId,
  tier: game.tier,
  verdict: game.verdict,
  rating: game.rating ?? 0,
  source: "retro" as const,
}));
---

<Layout title="Тир лист">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="text-2xl font-bold">Тир лист</h1>
    <a href="/dashboard" class="text-sm text-gray-400 transition hover:text-white">&larr; Назад</a>
  </div>

  {games.length === 0 ? (
    <p class="text-gray-500">Пока нет обзоров. Крути рулетку и пиши отзывы!</p>
  ) : (
    <TierList client:load games={games} />
  )}
</Layout>
