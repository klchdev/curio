---
import Layout from "../layouts/Layout.astro";
import { getSessionUser } from "../lib/session";
import {
  getActiveSlots,
  getUnplayedGames,
  getAttentionQueue,
  getLatestRecommendations,
  getActiveRun,
  getReviewCorpusSize,
  getTierList,
  getHistory,
  getDemoReviews,
  getStats,
  getFreeSkips,
} from "../lib/queries";
import Hub, { type Zone } from "../components/hub/Hub";
import { localeFrom } from "../lib/i18n";
import { t } from "../lib/strings";
import { THRESHOLDS } from "../lib/vocab";
import { getLlmSettings } from "../lib/llm/credentials";
import { db } from "../db";
import { users, userGames } from "../db/schema";
import { eq, sql } from "drizzle-orm";

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect("/");

/*
 * Everyone brings their own model key, so a fresh account is an empty product,
 * not "a dashboard without data". We steer people into setup, but only while
 * they have never opened it: once it has been skipped, a person is entitled to
 * sit in an empty app and not be thrown out of it on every visit.
 */
const [llm, onboardingRow, libraryRow] = await Promise.all([
  getLlmSettings(user.id),
  db
    .select({ completedAt: users.onboardingCompletedAt })
    .from(users)
    .where(eq(users.id, user.id))
    .limit(1)
    .then((rows) => rows[0]),
  db
    .select({ n: sql<number>`count(*)::int` })
    .from(userGames)
    .where(eq(userGames.userId, user.id))
    .then((rows) => rows[0]),
]);

if (!onboardingRow?.completedAt && !llm.keyMask) return Astro.redirect("/onboarding");

const librarySize = libraryRow?.n ?? 0;

/*
 * The hub gets everything from the server in one pass: all the island has left
 * to do is switch zones and send actions, it must never fetch anything more.
 */
const locale = localeFrom(Astro.cookies, Astro.request);

// Redirects from the old pages carry a zone — otherwise the tier list lands "somewhere else"
const zoneParam = Astro.url.searchParams.get("zone");
const initialZone: Zone =
  zoneParam === "now" || zoneParam === "recap" ? zoneParam : "choose";
const s = t(locale);

const [
  activeSlots,
  pool,
  attention,
  run,
  activeRun,
  reviewCount,
  tierGames,
  history,
  demos,
  stats,
  freeSkips,
] = await Promise.all([
  getActiveSlots(user.id),
  getUnplayedGames(user.id),
  getAttentionQueue(user.id),
  getLatestRecommendations(user.id),
  getActiveRun(user.id),
  getReviewCorpusSize(user.id),
  getTierList(user.id),
  getHistory(user.id),
  getDemoReviews(user.id),
  getStats(user.id),
  getFreeSkips(user.id),
]);

const dateFormat = new Intl.DateTimeFormat(locale === "en" ? "en-GB" : "ru-RU", {
  day: "numeric",
  month: "long",
});

/*
 * What is missing for the app to work in full. There is exactly one notice,
 * and it is the first missing thing in order: the steps depend on each other,
 * and three simultaneous complaints on an empty account do not help, they
 * drown each other out.
 *
 * Staying silent is not an option here: without a key the AI features simply
 * answer nothing, and the person has no way of knowing it is not a breakage.
 */
const reviewsLeft = THRESHOLDS.MIN_REVIEWS_TO_RUN - reviewCount;
const setupGap: "key" | "library" | "reviews" | null = !llm.keyMask
  ? "key"
  : librarySize === 0
    ? "library"
    : reviewsLeft > 0
      ? "reviews"
      : null;

const GAP_NOTICE = {
  key: {
    title: s.llm.missingTitle,
    text: s.llm.missingText,
    cta: s.llm.missingCta,
    href: "/settings",
  },
  library: {
    title: s.onboarding.needLibraryTitle,
    text: s.onboarding.needLibraryText,
    cta: s.onboarding.needLibraryCta,
    href: "/onboarding?step=library",
  },
  reviews: {
    title: s.onboarding.needReviewsTitle(reviewsLeft),
    text: s.onboarding.needReviewsText,
    cta: s.onboarding.needReviewsCta,
    href: "/onboarding?step=reviews",
  },
};

const notice = setupGap ? GAP_NOTICE[setupGap] : null;
---

<Layout title="Curio">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      {user.avatarUrl && <img src={user.avatarUrl} alt="" class="h-9 w-9 rounded-full" />}
      <span class="font-medium">{user.username}</span>
    </div>
    <div class="flex items-center gap-4 text-sm text-gray-500">
      <a href="/history" class="transition hover:text-white">{s.nav.diary}</a>
      <a href="/chrono" class="transition hover:text-white">{s.chrono.nav}</a>
      <a href="/demos" class="transition hover:text-white">{s.nav.demos}</a>
      <a href="/profile" class="transition hover:text-white">{s.nav.profile}</a>
      <a href="/auth/logout" class="text-red-400/80 transition hover:text-red-300">{s.nav.logout}</a>
    </div>
  </div>

  {notice && (
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-amber-800/60 bg-amber-950/20 px-5 py-4">
      <div class="max-w-xl">
        <p class="font-medium text-amber-200">{notice.title}</p>
        <p class="mt-1 text-sm leading-relaxed text-amber-200/70">{notice.text}</p>
      </div>
      <a
        href={notice.href}
        class="shrink-0 rounded-xl bg-amber-500 px-4 py-2 text-sm font-medium text-amber-950 transition hover:bg-amber-400"
      >
        {notice.cta}
      </a>
    </div>
  )}

  <Hub
    client:load
    picks={run?.items ?? []}
    slots={activeSlots.map(({ slot, game, currentPlaytime }) => ({
      slotId: slot.id,
      gameId: game.id,
      title: game.title,
      image: game.headerImage,
      played: (currentPlaytime ?? 0) - slot.playtimeOnStart,
    }))}
    updates={attention.items
      .filter((item) => item.reason === "update")
      .map((item) => ({
        gameId: item.gameId,
        title: item.title,
        headerImage: item.headerImage,
        currentPlaytime: item.currentPlaytime,
        lastRecordedPlaytime: item.lastRecordedPlaytime,
        delta: item.delta,
        verdict: item.existingVerdict,
        rating: item.existingRating,
        tier: item.existingTier,
      }))}
    queue={attention.items
      .filter((item) => item.reason === "triage")
      .map((item) => ({
        gameId: item.gameId,
        title: item.title,
        headerImage: item.headerImage,
        playtimeMinutes: item.playtimeMinutes,
        hasReview: item.hasReview,
      }))}
    queueTotal={attention.triageTotal}
    tierGames={tierGames.map((g) => ({
      gameId: g.gameId,
      title: g.gameTitle,
      image: g.gameImage,
      tier: g.tier,
    }))}
    diary={history
      .filter((entry) => entry.type === "reviewed")
      .slice(0, 6)
      .map((entry) => ({
        id: entry.entryId,
        gameId: entry.gameId,
        title: entry.gameTitle,
        note: entry.note,
        kind: entry.kind,
        playtimeMinutes: entry.playtimeMinutes,
        deltaMinutes: entry.deltaMinutes,
        verdict: entry.verdict,
        tier: entry.tier,
        origin: entry.origin,
      }))}
    demos={demos.slice(0, 8).map((d) => ({
      gameId: d.gameId,
      title: d.title,
      headerImage: d.headerImage,
      tier: d.tier,
      note: d.note,
    }))}
    stats={stats}
    reviewCount={reviewCount}
    poolSize={pool.length}
    freeSkips={freeSkips.available}
    locale={locale}
    initialZone={initialZone}
    lastSyncAt={user.lastLibrarySync ? new Date(user.lastLibrarySync).getTime() : null}
    runProfile={run?.profile ?? null}
    runDate={run ? dateFormat.format(new Date(run.createdAt)) : null}
    activeRunId={activeRun?.id ?? null}
    activeRunProgress={
      activeRun
        ? {
            stage: activeRun.stage,
            picksReady: activeRun.picksReady,
            startedAt: new Date(activeRun.createdAt).getTime(),
          }
        : null
    }
  />
</Layout>
