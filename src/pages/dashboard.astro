---
import Layout from "../layouts/Layout.astro";
import { getSessionUser } from "../lib/session";
import {
  getActiveSlots,
  getUnplayedGames,
  getAttentionQueue,
  getLatestRecommendations,
  getActiveRun,
  getReviewCorpusSize,
  getTierList,
  getHistory,
  getDemoReviews,
  getStats,
} from "../lib/queries";
import Hub from "../components/hub/Hub";

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect("/");

/*
 * Хаб получает всё с сервера одним заходом: острову остаётся переключать
 * зоны и отправлять действия, догружать он ничего не должен.
 */
const [activeSlots, pool, attention, run, activeRun, reviewCount, tierGames, history, demos, stats] =
  await Promise.all([
    getActiveSlots(user.id),
    getUnplayedGames(user.id),
    getAttentionQueue(user.id),
    getLatestRecommendations(user.id),
    getActiveRun(user.id),
    getReviewCorpusSize(user.id),
    getTierList(user.id),
    getHistory(user.id),
    getDemoReviews(user.id),
    getStats(user.id),
  ]);

const dateFormat = new Intl.DateTimeFormat("ru-RU", { day: "numeric", month: "long" });
---

<Layout title="BacklogRoulette">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      {user.avatarUrl && <img src={user.avatarUrl} alt="" class="h-9 w-9 rounded-full" />}
      <span class="font-medium">{user.username}</span>
    </div>
    <div class="flex items-center gap-4 text-sm text-gray-500">
      <a href="/history" class="transition hover:text-white">Дневник</a>
      <a href="/demos" class="transition hover:text-white">Демки</a>
      <a href="/profile" class="transition hover:text-white">Профиль</a>
      <a href="/auth/logout" class="text-red-400/80 transition hover:text-red-300">Выйти</a>
    </div>
  </div>

  <Hub
    client:load
    picks={run?.items ?? []}
    abandoned={run?.abandoned ?? []}
    slots={activeSlots.map(({ slot, game, currentPlaytime }) => ({
      slotId: slot.id,
      gameId: game.id,
      title: game.title,
      image: game.headerImage,
      played: (currentPlaytime ?? 0) - slot.playtimeOnStart,
    }))}
    queue={attention.items
      .filter((item) => item.reason === "triage")
      .map((item) => ({
        gameId: item.gameId,
        title: item.title,
        headerImage: item.headerImage,
        playtimeMinutes: item.playtimeMinutes,
      }))}
    queueTotal={attention.triageTotal}
    tierGames={tierGames.map((g) => ({
      gameId: g.gameId,
      title: g.gameTitle,
      image: g.gameImage,
      tier: g.tier,
    }))}
    diary={history
      .filter((entry) => entry.type === "reviewed")
      .slice(0, 6)
      .map((entry) => ({
        id: entry.entryId,
        gameId: entry.gameId,
        title: entry.gameTitle,
        note: entry.note,
        kind: entry.kind,
        playtimeMinutes: entry.playtimeMinutes,
        deltaMinutes: entry.deltaMinutes,
        verdict: entry.verdict,
        tier: entry.tier,
      }))}
    demos={demos.slice(0, 8).map((d) => ({
      gameId: d.gameId,
      title: d.title,
      headerImage: d.headerImage,
      tier: d.tier,
      note: d.note,
    }))}
    stats={stats}
    reviewCount={reviewCount}
    poolSize={pool.length}
    runProfile={run?.profile ?? null}
    runDate={run ? dateFormat.format(new Date(run.createdAt)) : null}
    activeRunId={activeRun?.id ?? null}
  />
</Layout>
