---
import Layout from "../layouts/Layout.astro";
import { getSessionUser } from "../lib/session";
import { getActiveSlots, canSpin, getUnplayedGames, getGamesNeedingReview, getFreeSkips } from "../lib/queries";
import SlotCard from "../components/SlotCard";
import RouletteButton from "../components/RouletteButton";
import SyncButton from "../components/SyncButton";
import NeedsReviewList from "../components/NeedsReviewList";

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect("/");

const activeSlots = await getActiveSlots(user.id);
const canSpinNow = await canSpin(user.id);
const poolSize = (await getUnplayedGames(user.id)).length;
const needsReview = await getGamesNeedingReview(user.id);
const freeSkipInfo = await getFreeSkips(user.id);

const navLink =
  "whitespace-nowrap rounded-lg border border-gray-700 px-3 py-2 text-sm transition hover:bg-gray-800";

const slotData = activeSlots.map(({ slot, game, currentPlaytime }) => ({
  slotId: slot.id,
  title: game.title,
  headerImage: game.headerImage,
  hltbMinutes: game.hltbMinutes,
  startedAt: slot.startedAt instanceof Date ? slot.startedAt.toISOString() : String(slot.startedAt),
  playedMinutes: (currentPlaytime ?? 0) - slot.playtimeOnStart,
  freeSkips: freeSkipInfo.available,
}));
---

<Layout title="Дашборд">
  <div class="mb-8 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
    <div class="flex shrink-0 items-center gap-4">
      {user.avatarUrl && (
        <img src={user.avatarUrl} alt="" class="h-12 w-12 rounded-full" />
      )}
      <div>
        <h1 class="text-2xl leading-tight font-bold">{user.username}</h1>
        <p class="text-sm whitespace-nowrap text-gray-400">Игр в пуле: {poolSize}</p>
      </div>
    </div>
    <nav class="flex flex-wrap items-center gap-2">
      <SyncButton client:idle />
      <a href="/history" class={navLink}>Дневник</a>
      <a href="/tier-list" class={navLink}>Тир лист</a>
      <a href="/recommendations" class={navLink}>Рекомендации</a>
      <a href="/demos" class={navLink}>Демки</a>
      <a href="/profile" class={navLink}>Профиль</a>
      <span class="mx-1 h-6 w-px bg-gray-800" aria-hidden="true"></span>
      <a href="/auth/logout" class={`${navLink} text-red-400`}>Выйти</a>
    </nav>
  </div>

  <section class="mb-10">
    <h2 class="mb-4 text-center text-xl font-semibold">Активные слоты ({activeSlots.length}/3)</h2>
    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-4 md:grid-cols-3">
      {slotData.map((props) => (
        <SlotCard client:idle {...props} />
      ))}

      {canSpinNow && poolSize > 0 && (
        <RouletteButton client:idle />
      )}
    </div>

    {!canSpinNow && (
      <div class="mx-auto mt-6 max-w-4xl rounded-xl border border-gray-800 bg-gray-900/50 py-6 text-center text-gray-500">
        <span class="text-2xl">🔒</span>
        <p class="mt-2">Все слоты заняты. Закрой или пропусти игру, чтобы крутить снова.</p>
      </div>
    )}
  </section>

  <NeedsReviewList client:idle items={needsReview} />
</Layout>
