---
import Layout from "../layouts/Layout.astro";
import { getSessionUser } from "../lib/session";
import {
  getLatestRecommendations,
  getReviewCorpus,
  getActiveRun,
  getAttentionQueue,
} from "../lib/queries";
import Recommendations from "../components/Recommendations";
import TriageList from "../components/TriageList";

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect("/");

const run = await getLatestRecommendations(user.id);
const active = await getActiveRun(user.id);
const reviewCount = (await getReviewCorpus(user.id)).length;
const attention = await getAttentionQueue(user.id);
const untriaged = attention.items.filter((item) => item.reason === "triage");
const untriagedTotal = attention.triageTotal;

const iso = (value: Date | string) =>
  value instanceof Date ? value.toISOString() : String(value);

const runData = run ? { ...run, createdAt: iso(run.createdAt) } : null;
const activeRunData = active ? { ...active, createdAt: iso(active.createdAt) } : null;
---

<Layout title="Рекомендации">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="text-2xl font-bold">Что играть дальше</h1>
    <a href="/dashboard" class="text-sm text-gray-400 transition hover:text-white">&larr; Назад</a>
  </div>

  {untriaged.length > 0 && (
    <TriageList client:load games={untriaged} total={untriagedTotal} />
  )}

  <Recommendations
    client:load
    run={runData}
    activeRun={activeRunData}
    canGenerate={reviewCount >= 5}
    reviewCount={reviewCount}
  />
</Layout>
