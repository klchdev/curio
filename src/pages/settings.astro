---
import Layout from "../layouts/Layout.astro";
import LlmKeyForm, { type ProviderMeta } from "../components/LlmKeyForm";
import AnalyticsOptOut from "../components/AnalyticsOptOut.astro";
import { getSessionUser } from "../lib/session";
import { localeFrom } from "../lib/i18n";
import { t } from "../lib/strings";
import { ADAPTER_LIST } from "../lib/llm";
import { getLlmSettings } from "../lib/llm/credentials";

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect("/");

const locale = localeFrom(Astro.cookies, Astro.request);
const s = t(locale);

const settings = await getLlmSettings(user.id);

/*
 * Only plain data goes outward: the adapters themselves pull in the SDKs of
 * three providers, and handing them to an island means dragging all of that
 * into the browser.
 */
const providers: ProviderMeta[] = ADAPTER_LIST.map((adapter) => ({
  id: adapter.id,
  label: adapter.label,
  keyHelpUrl: adapter.keyHelpUrl,
  needsKey: adapter.needsKey !== false,
  models: adapter.models,
}));
---

<Layout title={s.llm.title}>
  <div class="mx-auto max-w-xl py-10">
    <a href="/dashboard" class="text-sm text-gray-500 transition hover:text-gray-300">
      &larr; {s.pages.back}
    </a>

    <h1 class="mt-4 text-2xl font-semibold text-gray-100">{s.llm.title}</h1>
    <p class="mt-2 text-sm leading-relaxed text-gray-400">{s.llm.intro}</p>

    <div class="mt-8 rounded-2xl border border-gray-800 bg-gray-900/40 p-5">
      <LlmKeyForm client:load providers={providers} current={settings} locale={locale} />
    </div>

    <!--
      The threat model, spelled out, right under the field that asks for a key
      somebody pays money on. Folded away rather than absent: the person who
      does not care scrolls past a single line, and the person who does gets
      the whole answer without having to read the source.
    -->
    <details class="group mt-6">
      <summary
        class="cursor-pointer list-none text-sm text-gray-400 transition hover:text-gray-200"
      >
        <span class="inline-block text-gray-600 transition group-open:rotate-90">›</span>
        {s.llm.trustTitle}
      </summary>
      <ul class="mt-3 space-y-2.5 border-l border-gray-800 pl-4 text-xs leading-relaxed text-gray-500">
        {s.llm.trustPoints.map((point) => <li>{point}</li>)}
      </ul>
    </details>

    <!--
      The counter is named on the same screen that lists what the server sees,
      and the switch stands right under the sentence describing it. Anything
      else — a mention in a policy file nobody opens — would be the polite
      version of not saying it.
    -->
    <section class="mt-6 rounded-2xl border border-gray-800 bg-gray-900/40 p-5">
      <h2 class="text-sm font-medium text-gray-300">{s.analytics.title}</h2>
      <p class="mt-2 text-xs leading-relaxed text-gray-500">{s.analytics.text}</p>
      <AnalyticsOptOut class="mt-3 text-xs text-gray-400" />
      <p class="mt-2 text-xs leading-relaxed text-gray-600">{s.analytics.note}</p>
    </section>
  </div>
</Layout>
