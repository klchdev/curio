---
/**
 * Curio without an account.
 *
 * Three walls stand in a row between a visitor and their first "ah, I get it":
 * signing in through Steam, bringing your own model key, and writing a dozen
 * reviews. Until those are cleared, the app shows an empty diary and asks to
 * be taken on faith — and there is nothing to take on faith, because the whole
 * point of Curio is only visible on a filled-in account.
 *
 * So the demo does not open on a finished account either: it stops one step
 * short, on the screen that offers to read the diary, and lets the visitor press
 * the button themselves. That press is the product — everything before it (a
 * library pulled from Steam, reviews imported) is a chore a guest does not have,
 * since the library is invented and the reviews are already written. What is on
 * screen is the production hub doing its production job; the only thing replaced
 * is the server behind it, which the demo does not have.
 *
 * The session is deliberately never asked for here: no redirect, no user in
 * the database, no trip to Steam, not a single model call. Everything on the
 * screen was computed ahead of time in `demo-fixtures.ts`, and how much of it
 * is shown depends on how far the visitor has walked.
 *
 * The prop layout mirrors `dashboard.astro` line for line — and must keep
 * mirroring it. The moment the demo starts feeding the hub its own way, it
 * stops being a demonstration of the product and becomes a separate product.
 */
import Layout from "../layouts/Layout.astro";
import DemoBanner from "../components/demo/DemoBanner.astro";
import DemoCta from "../components/demo/DemoCta.astro";
import DemoHub from "../components/demo/DemoHub";
import { demoRun, runVariantFrom } from "../components/demo/demo-run";
import { spinFrom, stepFrom } from "../components/demo/demo-step";
import type { Zone } from "../components/hub/Hub";
import { DEMO } from "../lib/demo-fixtures";
import { localeFrom } from "../lib/i18n";
import { t } from "../lib/strings";

const locale = localeFrom(Astro.cookies, Astro.request);
const s = t(locale);

const hasAdvice = stepFrom(Astro.url.searchParams) === "advice";

/*
 * Which advice set to show. Regenerating advice ends in a reload, and the mock
 * points this parameter at the other set on its way out — so the freshly
 * "generated" run is already in the first server-rendered frame.
 */
const run = demoRun(runVariantFrom(Astro.url.searchParams));

/*
 * A contract the visitor won on a blind roll. The roll reloads the page, so the
 * winner arrives in the address; without this it would flash and disappear, and
 * the roulette would look broken rather than mocked. Playtime starts at zero
 * because the pool is unplayed games by definition — the contract is judged by
 * what gets played from here on.
 */
const spunId = spinFrom(Astro.url.searchParams);
const spun = spunId === null ? undefined : DEMO.pool.find((game) => game.id === spunId);
const spunSlot = spun
  ? [{ slotId: 9999, gameId: spun.id, title: spun.title, image: spun.headerImage, played: 0 }]
  : [];

// The zone lives in the URL — the hub writes it there itself, and a link to a zone must work
const zoneParam = Astro.url.searchParams.get("zone");
const initialZone: Zone =
  zoneParam === "now" || zoneParam === "recap" ? zoneParam : "choose";

const dateFormat = new Intl.DateTimeFormat(locale === "en" ? "en-GB" : "ru-RU", {
  day: "numeric",
  month: "long",
});

/*
 * What is already in place before the visitor presses anything.
 *
 * Without this the advisor looks like it works on nothing: the screen asks to
 * read "15 reviews" that the guest never saw arrive. Naming the three inputs
 * also gives the demo its only chance to say who the key belongs to — the guest
 * is never asked for one here, and a service that quietly runs on somebody
 * else's key is a promise it cannot keep.
 */
const ready = [
  s.demo.readyKey,
  s.demo.readyLibrary(DEMO.stats.totalLibrary),
  s.demo.readyReviews(DEMO.reviewCount),
];
---

<Layout title={s.demo.title}>
  <DemoBanner />

  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      {DEMO.user.avatarUrl && <img src={DEMO.user.avatarUrl} alt="" class="h-9 w-9 rounded-full" />}
      <span class="font-medium">{DEMO.user.username}</span>
    </div>
    <div class="flex items-center gap-4 text-sm text-gray-500">
      {/*
        Not everyone came to walk a path — some just want to see the product.
        Without this the demo turns into a quest, which is its own kind of wall.
      */}
      {!hasAdvice && (
        <a href="/try?step=advice" class="text-emerald-400/90 transition hover:text-emerald-300">
          {s.demo.skipToEnd}
        </a>
      )}
      <a href="/try/demos" class="transition hover:text-white">{s.nav.demos}</a>
      <a href="/" class="transition hover:text-white">{s.demo.backToLanding}</a>
    </div>
  </div>

  {!hasAdvice && (
    <div class="mb-8 rounded-2xl border border-gray-800 bg-gray-900/40 p-5">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-300">
        {ready.map((line) => (
          <li class="flex items-center gap-2">
            <span class="text-emerald-400">✓</span>
            {line}
          </li>
        ))}
      </ul>
      <p class="mt-3 text-xs leading-relaxed text-gray-500">{s.demo.readyKeyHint}</p>
    </div>
  )}

  <DemoHub
      client:load
      picks={hasAdvice ? run.items : []}
      slots={[
        ...(hasAdvice
          ? DEMO.slots.map(({ slot, game, currentPlaytime }) => ({
              slotId: slot.id,
              gameId: game.id,
              title: game.title,
              image: game.headerImage,
              played: (currentPlaytime ?? 0) - slot.playtimeOnStart,
            }))
          : []),
        ...spunSlot,
      ]}
      updates={DEMO.attention.items
        .filter((item) => item.reason === "update")
        .map((item) => ({
          gameId: item.gameId,
          title: item.title,
          headerImage: item.headerImage,
          currentPlaytime: item.currentPlaytime,
          lastRecordedPlaytime: item.lastRecordedPlaytime,
          delta: item.delta,
          verdict: item.existingVerdict,
          rating: item.existingRating,
          tier: item.existingTier,
        }))}
      queue={DEMO.attention.items
        .filter((item) => item.reason === "triage")
        .map((item) => ({
          gameId: item.gameId,
          title: item.title,
          headerImage: item.headerImage,
          playtimeMinutes: item.playtimeMinutes,
          hasReview: item.hasReview,
        }))}
      queueTotal={DEMO.attention.triageTotal}
      tierGames={DEMO.tierList.map((g) => ({
        gameId: g.gameId,
        title: g.gameTitle,
        image: g.gameImage,
        tier: g.tier,
      }))}
      diary={DEMO.history
        .filter((entry) => entry.type === "reviewed")
        .slice(0, 6)
        .map((entry) => ({
          id: entry.entryId,
          gameId: entry.gameId,
          title: entry.gameTitle,
          note: entry.note,
          kind: entry.kind,
          playtimeMinutes: entry.playtimeMinutes,
          deltaMinutes: entry.deltaMinutes,
          verdict: entry.verdict,
          tier: entry.tier,
          origin: entry.origin,
        }))}
      demos={DEMO.demos.slice(0, 8).map((d) => ({
        gameId: d.gameId,
        title: d.title,
        headerImage: d.headerImage,
        tier: d.tier,
        note: d.note,
      }))}
      stats={DEMO.stats}
      reviewCount={DEMO.reviewCount}
      poolSize={DEMO.pool.length}
      freeSkips={DEMO.freeSkips.available}
      locale={locale}
      initialZone={initialZone}
      lastSyncAt={DEMO.user.lastLibrarySync ? new Date(DEMO.user.lastLibrarySync).getTime() : null}
      runProfile={hasAdvice ? run.profile : null}
      runDate={hasAdvice ? dateFormat.format(new Date(run.createdAt)) : null}
      activeRunId={null}
      activeRunProgress={null}
    />

  {/* The call to action belongs at the finish, where there is something to lose */}
  {hasAdvice && (
    <div class="pb-28">
      <DemoCta />
    </div>
  )}
</Layout>
