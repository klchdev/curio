---
import Layout from "../../layouts/Layout.astro";
import VariantSwitcher from "../../components/mockup/VariantSwitcher.astro";
import Stage from "../../components/mockup/Stage";
import { loadMockData } from "./_data";

const data = await loadMockData(Astro);
if (!data) return Astro.redirect("/");

// ?state=empty — ещё не запускал генерацию; ?state=gate — отзывов не хватает
const param = Astro.url.searchParams.get("state");
const demoState = param === "empty" || param === "gate" ? param : "ready";

const {
  picks, abandoned, slots, queue, diary, demos,
  tierCounts, shelf, poolSize, poolPreview, reviewCount, stats,
} = data;
---

<Layout title="Макет: сцена">
  <VariantSwitcher current="stage" />

  <div class="mb-6 flex flex-wrap gap-2 text-xs">
    <span class="text-gray-600">Состояние экрана:</span>
    {[
      ["ready", "с рекомендациями"],
      ["empty", "ещё не собирал"],
      ["gate", "мало отзывов"],
    ].map(([value, label]) => (
      <a
        href={value === "ready" ? "/mockup/stage" : `/mockup/stage?state=${value}`}
        class:list={[
          "rounded-full border px-2.5 py-1 transition",
          demoState === value
            ? "border-emerald-700 text-emerald-300"
            : "border-gray-800 text-gray-500 hover:text-white",
        ]}
      >
        {label}
      </a>
    ))}
  </div>

  <Stage
    client:load
    demoState={demoState}
    picks={picks}
    abandoned={abandoned}
    slots={slots}
    queue={queue}
    diary={diary}
    demos={demos}
    tierCounts={tierCounts}
    shelf={shelf}
    poolSize={poolSize}
    poolPreview={poolPreview}
    reviewCount={reviewCount}
    stats={stats}
  />
</Layout>
