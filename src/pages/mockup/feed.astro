---
import Layout from "../../layouts/Layout.astro";
import VariantSwitcher from "../../components/mockup/VariantSwitcher.astro";
import { loadMockData, TIER_STYLE } from "./_data";

const data = await loadMockData(Astro);
if (!data) return Astro.redirect("/");

const { run, picks, byTier, abandoned, slots, queue, stats } = data;
const hero = [...byTier("S"), ...byTier("A")];
const rest = picks.filter((p) => !hero.includes(p));
const profileLines = (run?.profile ?? "")
  .split("\n")
  .map((l) => l.trim().replace(/^[-*•]\s*/, ""))
  .filter(Boolean);
---

<Layout title="Макет: лента">
  <VariantSwitcher current="feed" />

  <div class="mx-auto max-w-3xl">
    <header class="mb-8">
      <p class="text-sm text-gray-500">
        {run
          ? `Собрано по ${run.reviewsUsed} отзывам · ${picks.length} игр разобрано`
          : "Прогона ещё нет"}
      </p>
      <h1 class="mt-1 text-3xl font-bold">Что играть дальше</h1>
    </header>

    {profileLines.length > 0 && (
      <details class="mb-8 rounded-xl border border-gray-800 bg-gray-900/40 p-5" open>
        <summary class="cursor-pointer text-sm font-medium text-gray-300">
          Что видно по твоим отзывам
        </summary>
        <div class="mt-3 space-y-2">
          {profileLines.slice(0, 5).map((line) => (
            <p class="text-sm leading-relaxed text-gray-400">{line.replace(/\*\*/g, "")}</p>
          ))}
        </div>
      </details>
    )}

    <section class="space-y-4">
      {hero.map((pick) => (
        <article class="overflow-hidden rounded-2xl border border-gray-800 bg-gray-900/40 transition hover:border-gray-700">
          {pick.headerImage && (
            <img src={pick.headerImage} alt="" class="h-40 w-full object-cover" />
          )}
          <div class="p-5">
            <div class="mb-2 flex flex-wrap items-center gap-3">
              <span class={`flex h-7 w-7 items-center justify-center rounded-lg text-sm font-bold ${TIER_STYLE[pick.tier]?.chip}`}>
                {pick.tier}
              </span>
              <h2 class="text-lg font-semibold">{pick.title}</h2>
              <span class="text-xs text-gray-500">
                {pick.hours > 0 ? `${pick.hours}ч` : "не запускал"}
              </span>
            </div>
            <p class="text-sm leading-relaxed text-gray-400">{pick.reason}</p>
            <div class="mt-4 flex gap-2">
              <button class="rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-medium transition hover:bg-emerald-500">
                Взять в слот
              </button>
              <button class="rounded-lg border border-gray-700 px-3 py-1.5 text-sm transition hover:bg-gray-800">
                Карточка игры
              </button>
            </div>
          </div>
        </article>
      ))}
    </section>

    {rest.length > 0 && (
      <details class="mt-4 rounded-xl border border-gray-800 bg-gray-900/30 p-5">
        <summary class="cursor-pointer font-medium">
          Остальные советы <span class="text-gray-500">({rest.length})</span>
        </summary>
        <ul class="mt-4 space-y-3">
          {rest.map((pick) => (
            <li class="flex gap-3">
              <span class={`mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded text-xs font-bold ${TIER_STYLE[pick.tier]?.chip}`}>
                {pick.tier}
              </span>
              <div>
                <p class="font-medium">{pick.title}</p>
                <p class="text-sm text-gray-500">{pick.reason}</p>
              </div>
            </li>
          ))}
        </ul>
      </details>
    )}

    {abandoned.length > 0 && (
      <details class="mt-4 rounded-xl border border-amber-900/60 bg-amber-950/10 p-5">
        <summary class="cursor-pointer font-medium">
          Спор о брошенном <span class="text-gray-500">({abandoned.length})</span>
        </summary>
        <ul class="mt-4 space-y-3">
          {abandoned.map((item) => (
            <li class="rounded-lg border border-gray-800 bg-gray-900/40 p-3">
              <div class="flex flex-wrap items-baseline gap-2">
                <span class="font-medium">{item.title}</span>
                <span class="text-xs text-gray-500">{item.hours}ч</span>
                <span class={`rounded px-2 py-0.5 text-xs ${item.stance === "disagree" ? "bg-amber-900/60 text-amber-200" : "bg-gray-800 text-gray-400"}`}>
                  {item.stance === "disagree" ? "Дай второй шанс" : "Бросил по делу"}
                </span>
              </div>
              <p class="mt-1 text-sm text-gray-400">{item.text}</p>
            </li>
          ))}
        </ul>
      </details>
    )}

    <details class="mt-4 rounded-xl border border-gray-800 bg-gray-900/30 p-5">
      <summary class="cursor-pointer font-medium">
        Активные слоты <span class="text-gray-500">({slots.length}/3)</span>
      </summary>
      <ul class="mt-4 grid gap-3 sm:grid-cols-3">
        {slots.map((slot) => (
          <li class="rounded-lg border border-gray-800 bg-gray-900/40 p-3">
            {slot.image && <img src={slot.image} alt="" class="mb-2 h-16 w-full rounded object-cover" />}
            <p class="text-sm font-medium">{slot.title}</p>
            <p class="text-xs text-gray-500">{slot.played} мин с начала</p>
          </li>
        ))}
      </ul>
    </details>

    <details class="mt-4 rounded-xl border border-gray-800 bg-gray-900/30 p-5">
      <summary class="cursor-pointer font-medium">
        Разобрать сыгранное <span class="text-gray-500">({queue.length})</span>
      </summary>
      <ul class="mt-4 space-y-2">
        {queue.slice(0, 8).map((game) => (
          <li class="flex flex-wrap items-center gap-3 rounded-lg border border-gray-800 bg-gray-900/40 p-2">
            <span class="font-medium">{game.title}</span>
            <span class="text-xs text-gray-500">{game.hours}ч</span>
            <span class="ml-auto flex gap-1.5">
              <button class="rounded border border-emerald-800 px-2 py-1 text-xs text-emerald-300">Прошёл</button>
              <button class="rounded border border-red-900 px-2 py-1 text-xs text-red-300">Бросил</button>
            </span>
          </li>
        ))}
      </ul>
    </details>

    <p class="mt-8 text-center text-sm text-gray-600">
      {stats.totalGames} отзывов · {stats.totalLibrary} игр в библиотеке
    </p>
  </div>
</Layout>
