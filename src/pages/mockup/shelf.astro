---
import Layout from "../../layouts/Layout.astro";
import VariantSwitcher from "../../components/mockup/VariantSwitcher.astro";
import { loadMockData, TIER_STYLE } from "./_data";

const data = await loadMockData(Astro);
if (!data) return Astro.redirect("/");

const { run, picks, byTier, abandoned, shelf, queue, slots } = data;
const pinned = [...byTier("S"), ...byTier("A")].slice(0, 8);

// Полка: сначала то, у чего есть тир, потом неразобранное — тусклыми плитками.
const shelfTiles = [
  ...shelf.filter((g) => g.tier).map((g) => ({ ...g, dim: false })),
  ...queue.map((g) => ({
    gameId: -g.gameId,
    title: g.title,
    image: g.headerImage,
    tier: null,
    dim: true,
  })),
];
---

<Layout title="Макет: полка">
  <VariantSwitcher current="shelf" />

  <div class="mx-auto max-w-6xl">
    <section class="mb-10">
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-3">
        <h1 class="text-xl font-bold">
          Советует ИИ
          <span class="ml-2 text-sm font-normal text-gray-500">
            {run ? `по ${run.reviewsUsed} отзывам` : "прогона нет"}
          </span>
        </h1>
        <button class="rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-medium transition hover:bg-emerald-500">
          Пересобрать
        </button>
      </div>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {pinned.map((pick) => (
          <article class={`group overflow-hidden rounded-xl bg-gray-900 ring-2 transition hover:-translate-y-0.5 ${TIER_STYLE[pick.tier]?.ring}`}>
            {pick.headerImage && (
              <img src={pick.headerImage} alt="" class="h-24 w-full object-cover" />
            )}
            <div class="p-3">
              <div class="mb-1 flex items-center gap-2">
                <span class={`flex h-5 w-5 items-center justify-center rounded text-[11px] font-bold ${TIER_STYLE[pick.tier]?.chip}`}>
                  {pick.tier}
                </span>
                <span class="truncate text-sm font-medium">{pick.title}</span>
              </div>
              <p class="line-clamp-2 text-xs leading-snug text-gray-500">{pick.reason}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    {abandoned.length > 0 && (
      <section class="mb-10">
        <h2 class="mb-3 text-sm font-semibold text-amber-300">Спор о брошенном</h2>
        <div class="flex gap-3 overflow-x-auto pb-2">
          {abandoned.map((item) => (
            <article class={`w-64 shrink-0 rounded-xl border p-3 ${item.stance === "disagree" ? "border-amber-900/70 bg-amber-950/20" : "border-gray-800 bg-gray-900/30"}`}>
              <p class="truncate font-medium">{item.title}</p>
              <p class="mt-1 line-clamp-4 text-xs leading-relaxed text-gray-400">{item.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <section>
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <h2 class="mr-2 text-xl font-bold">Библиотека</h2>
        {["Тиры", "Статус", "Часы", "Неразобранное"].map((chip, index) => (
          <span class:list={[
            "rounded-lg border px-3 py-1 text-sm",
            index === 0 ? "border-emerald-600 bg-emerald-600/15 text-emerald-300" : "border-gray-800 text-gray-500",
          ]}>
            {chip}
          </span>
        ))}
        <span class="ml-auto text-sm text-gray-600">
          {shelf.filter((g) => g.tier).length} с тиром · {queue.length} без вердикта
        </span>
      </div>

      <div class="grid grid-cols-3 gap-2 sm:grid-cols-6 lg:grid-cols-8">
        {shelfTiles.slice(0, 96).map((tile) => (
          <div
            class:list={[
              "group relative aspect-[3/4] overflow-hidden rounded-lg bg-gray-900 transition hover:scale-105",
              tile.dim ? "opacity-35 grayscale" : "",
            ]}
            title={tile.title}
          >
            {tile.image && <img src={tile.image} alt="" class="h-full w-full object-cover" />}
            {tile.tier && (
              <span class={`absolute top-1 left-1 flex h-5 w-5 items-center justify-center rounded text-[11px] font-bold ${TIER_STYLE[tile.tier]?.chip}`}>
                {tile.tier}
              </span>
            )}
            <span class="absolute inset-x-0 bottom-0 truncate bg-gray-950/85 px-1.5 py-1 text-[11px] opacity-0 transition group-hover:opacity-100">
              {tile.title}
            </span>
          </div>
        ))}
      </div>
    </section>

    <p class="mt-8 text-center text-sm text-gray-600">
      Слоты {slots.length}/3 · дневник · статистика — в шапке
    </p>
  </div>
</Layout>
