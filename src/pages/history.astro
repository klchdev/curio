---
import Layout from "../layouts/Layout.astro";
import { getSessionUser } from "../lib/session";
import { getHistory } from "../lib/queries";
import { getDiaryMentions, getDiaryTags } from "../lib/entry-analysis";
import {
  formatPlaytime,
  verdictLabel,
  worthLabel,
  WORTH_COLORS,
  VERDICT_STYLE,
  TIER_STYLE,
} from "../lib/vocab";
import AddGameNoteButton from "../components/AddGameNoteButton";
import { localeFrom } from "../lib/i18n";
import { t } from "../lib/strings";

const user = await getSessionUser(Astro);
if (!user) return Astro.redirect("/");

/*
 * Дневник собирается в треды по играм. Плоская лента разносила записи об
 * одной игре по всей странице, и то, ради чего дневник вообще заведён —
 * как менялось мнение — приходилось собирать глазами. Внутри треда записи
 * идут снизу вверх по времени: сверху первое впечатление, дальше правки.
 */
const [timeline, mentions, entryTags] = await Promise.all([
  getHistory(user.id),
  getDiaryMentions(user.id),
  getDiaryTags(user.id),
]);

const locale = localeFrom(Astro.cookies, Astro.request);
const s = t(locale);

type Item = (typeof timeline)[number];

interface Thread {
  gameId: number;
  title: string;
  image: string | null;
  steamAppId: number | null;
  items: Item[];
  /** Последняя активность: по ней треды и выстраиваются. */
  touchedAt: number;
  playtimeMinutes: number;
  verdict: string | null;
  rating: number | null;
  tier: string | null;
}

const threads = new Map<number, Thread>();

for (const item of timeline) {
  const existing = threads.get(item.gameId);
  const at = new Date(item.date).getTime();

  const thread =
    existing ??
    ({
      gameId: item.gameId,
      title: item.gameTitle,
      image: item.gameImage,
      steamAppId: null,
      items: [],
      touchedAt: at,
      playtimeMinutes: 0,
      verdict: null,
      rating: null,
      tier: null,
    } satisfies Thread);

  thread.items.push(item);
  thread.touchedAt = Math.max(thread.touchedAt, at);

  /*
   * Итог игры берём из первой встреченной записи: лента приходит от новых
   * к старым, значит это и есть текущее состояние карточки.
   */
  if (item.type === "reviewed") {
    thread.steamAppId ??= item.steamAppId;
    if (thread.playtimeMinutes === 0) {
      thread.playtimeMinutes = item.playtimeMinutes;
      thread.verdict = item.currentVerdict;
      thread.rating = item.currentRating;
      thread.tier = item.currentTier;
    }
  }

  if (!existing) threads.set(item.gameId, thread);
}

const grouped = [...threads.values()]
  .map((thread) => ({
    ...thread,
    // Внутри треда — от старого к новому: так читается развитие мнения
    items: [...thread.items].reverse(),
  }))
  .sort((a, b) => b.touchedAt - a.touchedAt);

/*
 * Упоминания живут отдельно от текста записи: в базе лежат дословный кусок и
 * его позиция, а сам текст не трогается никогда. Здесь разметка только
 * накладывается на отрисовку — и накладывается лишь тогда, когда кусок на
 * своём месте совпал посимвольно.
 */
type Mention = (typeof mentions)[number];

const mentionsByEntry = new Map<number, Mention[]>();
/** Обратная сторона: где эту игру вспоминали, говоря о других. */
const mentionsOfGame = new Map<number, Mention[]>();

for (const mention of mentions) {
  const inEntry = mentionsByEntry.get(mention.entryId);
  if (inEntry) inEntry.push(mention);
  else mentionsByEntry.set(mention.entryId, [mention]);

  if (mention.targetGameId !== null && mention.targetGameId !== mention.sourceGameId) {
    const ofGame = mentionsOfGame.get(mention.targetGameId);
    if (ofGame) ofGame.push(mention);
    else mentionsOfGame.set(mention.targetGameId, [mention]);
  }
}

const tagsByEntry = new Map<number, (typeof entryTags)[number][]>();
for (const tag of entryTags) {
  const list = tagsByEntry.get(tag.entryId);
  if (list) list.push(tag);
  else tagsByEntry.set(tag.entryId, [tag]);
}

/** У игр с собственным тредом ссылка ведёт в дневник, у остальных — в магазин. */
const threadIds = new Set(grouped.map((thread) => thread.gameId));

function linkFor(gameId: number | null, steamAppId: number | null): string | null {
  if (gameId === null) return null;
  if (threadIds.has(gameId)) return `#game-${gameId}`;
  return steamAppId ? `https://store.steampowered.com/app/${steamAppId}` : null;
}

interface Segment {
  text: string;
  href: string | null;
  title: string | null;
}

function splitNote(note: string, found: Mention[]): Segment[] {
  const ordered = [...found].sort((a, b) => a.startOffset - b.startOffset);
  const segments: Segment[] = [];
  let cursor = 0;

  for (const mention of ordered) {
    const start = mention.startOffset;
    const end = start + mention.surface.length;
    // Разметка старше текста быть не может, но проверка дешевле съехавшей подсветки
    if (start < cursor || note.slice(start, end) !== mention.surface) continue;

    const href = linkFor(mention.targetGameId, mention.targetSteamAppId);
    if (!href) continue;

    if (start > cursor) segments.push({ text: note.slice(cursor, start), href: null, title: null });
    segments.push({ text: mention.surface, href, title: mention.targetTitle });
    cursor = end;
  }

  if (cursor < note.length) {
    segments.push({ text: note.slice(cursor), href: null, title: null });
  }
  return segments;
}

const KIND_LABEL: Record<string, string> = {
  first: s.pages.entryFirst,
  update: s.pages.entryUpdate,
  verdict: s.pages.entryVerdict,
  advisor: s.pages.entryAdvisor,
};

/** Вердикты, которыми тред закрывается: такая запись — итог, а не правка. */
const CLOSING_VERDICTS = new Set(["finished", "dropped", "endless"]);

function entryLabel(kind: string, verdict: string | null): string {
  if (kind === "verdict" && verdict && CLOSING_VERDICTS.has(verdict)) return s.pages.entryFinal;
  return KIND_LABEL[kind] ?? kind;
}

const dateFormat = new Intl.DateTimeFormat(locale === "en" ? "en-GB" : "ru-RU", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
---

<Layout title={s.pages.diary}>
  <div class="mb-8 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold">{s.pages.diary}</h1>
      <p class="text-sm text-gray-500">
        {s.pages.diaryCount(timeline.length)} · {s.pages.diaryGames(grouped.length)}
      </p>
    </div>
    <a href="/dashboard" class="text-sm text-gray-400 transition hover:text-white">&larr; {s.pages.back}</a>
  </div>

  {grouped.length === 0 ? (
    <p class="text-gray-500">{s.pages.diaryEmpty}</p>
  ) : (
    <div class="space-y-6">
      {grouped.map((thread) => (
        <section
          id={`game-${thread.gameId}`}
          class="overflow-hidden rounded-2xl border border-gray-800 bg-gray-900/30 scroll-mt-6"
        >
          <header class="flex flex-wrap items-center gap-4 border-b border-gray-800/80 bg-gray-900/40 p-4">
            {thread.image && (
              <img src={thread.image} alt="" class="header-art w-28 shrink-0 rounded-lg" />
            )}

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-2">
                {thread.steamAppId ? (
                  <a
                    href={`https://store.steampowered.com/app/${thread.steamAppId}`}
                    target="_blank"
                    rel="noreferrer"
                    class="text-lg font-semibold transition hover:text-emerald-400"
                  >
                    {thread.title}
                  </a>
                ) : (
                  <span class="text-lg font-semibold">{thread.title}</span>
                )}
                {thread.playtimeMinutes > 0 && (
                  <span class="text-xs text-gray-600">{formatPlaytime(thread.playtimeMinutes)}</span>
                )}
              </div>

              <div class="mt-1 flex flex-wrap items-center gap-3 text-xs">
                {thread.verdict && (
                  <span class="text-gray-400">
                    {VERDICT_STYLE[thread.verdict as keyof typeof VERDICT_STYLE]?.icon}{" "}
                    {verdictLabel(thread.verdict as keyof typeof VERDICT_STYLE)}
                  </span>
                )}
                {thread.rating && (
                  <span class={WORTH_COLORS[thread.rating - 1]}>{worthLabel(thread.rating)}</span>
                )}
                {thread.tier && (
                  <span
                    class:list={[
                      "flex h-5 w-5 items-center justify-center rounded text-[11px] font-bold",
                      TIER_STYLE[thread.tier as keyof typeof TIER_STYLE]?.bg,
                      TIER_STYLE[thread.tier as keyof typeof TIER_STYLE]?.text,
                    ]}
                  >
                    {thread.tier}
                  </span>
                )}
                <span class="text-gray-600">
                  {thread.items.length > 1
                    ? `${s.pages.diaryThread(thread.items.length)} · ${s.pages.diarySince}`
                    : s.pages.diaryThread(thread.items.length)}
                </span>
              </div>
            </div>

            <AddGameNoteButton
              client:visible
              locale={locale}
              gameId={thread.gameId}
              gameTitle={thread.title}
              currentPlaytime={thread.playtimeMinutes}
              lastRecordedPlaytime={thread.playtimeMinutes}
              currentVerdict={thread.verdict}
              currentRating={thread.rating}
              currentTier={thread.tier}
            />
          </header>

          {mentionsOfGame.has(thread.gameId) && (
            <div class="border-b border-gray-800/60 px-4 py-2.5 text-xs text-gray-500">
              {s.pages.mentionedIn(mentionsOfGame.get(thread.gameId)!.length)}:{" "}
              {[
                ...new Map(
                  mentionsOfGame
                    .get(thread.gameId)!
                    .map((mention) => [mention.sourceGameId, mention.sourceTitle])
                ),
              ].map(([gameId, title], index) => (
                <>
                  {index > 0 && <span class="text-gray-700"> · </span>}
                  <a href={`#game-${gameId}`} class="text-gray-400 transition hover:text-sky-300">
                    {title}
                  </a>
                </>
              ))}
            </div>
          )}

          <ol class="relative m-4 ml-7 space-y-4 border-l border-gray-800 pl-5">
            {thread.items.map((entry) => (
              <li class="relative">
                <span
                  class:list={[
                    "absolute top-2 -left-[27px] h-2.5 w-2.5 rounded-full",
                    entry.type === "skipped" ? "bg-rose-700" : "bg-gray-600",
                  ]}
                />

                {entry.type === "skipped" ? (
                  <div>
                    <div class="flex flex-wrap items-baseline gap-2">
                      <span
                        class:list={[
                          "rounded px-2 py-0.5 text-xs",
                          entry.reasonType === "shame"
                            ? "bg-rose-950/60 text-rose-300"
                            : "bg-gray-800 text-gray-400",
                        ]}
                      >
                        {entry.reasonType === "shame" ? s.pages.shame : s.pages.skipped}
                      </span>
                      <span class="ml-auto text-xs text-gray-600">
                        {dateFormat.format(new Date(entry.date))}
                      </span>
                    </div>
                    <p class="mt-1 text-sm text-gray-500">{entry.reasonText}</p>
                  </div>
                ) : (
                  <div>
                    <div class="flex flex-wrap items-baseline gap-2">
                      <span class="rounded bg-gray-800 px-2 py-0.5 text-xs text-gray-500">
                        {entryLabel(entry.kind, entry.verdict)}
                      </span>
                      <span class="text-xs text-gray-600">
                        {formatPlaytime(entry.playtimeMinutes)}
                        {entry.deltaMinutes > 0 && (
                          <span class="text-indigo-400"> · +{formatPlaytime(entry.deltaMinutes)}</span>
                        )}
                      </span>
                      {entry.origin === "steam" && (
                        <span class="rounded border border-sky-900 px-1.5 py-0.5 text-[10px] text-sky-400/80">
                          {s.pages.fromSteam}
                        </span>
                      )}
                      <span class="ml-auto text-xs text-gray-600">
                        {dateFormat.format(new Date(entry.date))}
                      </span>
                    </div>

                    <p class="mt-2 text-sm leading-relaxed whitespace-pre-line text-gray-300">
                      {splitNote(entry.note, mentionsByEntry.get(entry.entryId) ?? []).map((part) =>
                        part.href ? (
                          <a
                            href={part.href}
                            title={part.title}
                            class="text-sky-300/90 underline decoration-sky-500/40 underline-offset-2 transition hover:text-sky-200"
                          >
                            {part.text}
                          </a>
                        ) : (
                          part.text
                        )
                      )}
                    </p>

                    {/*
                      Теги предложены разбором и правятся тапом: снять —
                      крестик, добавить — плюс. Ни подтверждений, ни состояния
                      «на рассмотрении»: неверный тег стоит одного движения, а
                      необходимость подтверждать каждый стоила бы желания
                      вообще писать.
                    */}
                    <div class="tag-row mt-2 flex flex-wrap items-center gap-1.5" data-entry={entry.entryId}>
                      {(tagsByEntry.get(entry.entryId) ?? []).map((tag) => (
                        <span
                          class:list={[
                            "group inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px]",
                            tag.kind === "praise"
                              ? "bg-emerald-950/50 text-emerald-300/80"
                              : "bg-rose-950/40 text-rose-300/70",
                          ]}
                          data-tag={tag.tagId}
                        >
                          {tag.label}
                          <button
                            type="button"
                            class="tag-drop cursor-pointer opacity-0 transition group-hover:opacity-60 hover:!opacity-100"
                            aria-label={s.pages.tagRemove}
                          >
                            ✕
                          </button>
                        </span>
                      ))}
                      <button
                        type="button"
                        class="tag-add cursor-pointer rounded-full border border-dashed border-gray-700 px-2 py-0.5 text-[11px] text-gray-600 transition hover:border-gray-500 hover:text-gray-400"
                      >
                        + {s.pages.tagAdd}
                      </button>
                    </div>

                    <div class="mt-2 flex flex-wrap items-center gap-3 text-xs">
                      {entry.verdict && (
                        <span class="text-gray-400">
                          {VERDICT_STYLE[entry.verdict as keyof typeof VERDICT_STYLE]?.icon}{" "}
                          {verdictLabel(entry.verdict as keyof typeof VERDICT_STYLE)}
                        </span>
                      )}
                      {entry.rating && (
                        <span class={WORTH_COLORS[entry.rating - 1]}>{worthLabel(entry.rating)}</span>
                      )}
                      {entry.tier && (
                        <span
                          class:list={[
                            "flex h-5 w-5 items-center justify-center rounded text-[11px] font-bold",
                            TIER_STYLE[entry.tier as keyof typeof TIER_STYLE]?.bg,
                            TIER_STYLE[entry.tier as keyof typeof TIER_STYLE]?.text,
                          ]}
                        >
                          {entry.tier}
                        </span>
                      )}
                    </div>
                  </div>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  )}
</Layout>

<script>
  /*
   * Правка тегов делегированием, а не островом на каждую запись: записей в
   * дневнике сотни, и триста реактивных островов ради двух кнопок — цена без
   * выгоды. Разметку рисует сервер, здесь только клики.
   */
  const ENDPOINT = "/api/entry-tag";

  function chip(tagId: number, label: string, kind: string): HTMLElement {
    const span = document.createElement("span");
    span.className =
      "group inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] " +
      (kind === "praise"
        ? "bg-emerald-950/50 text-emerald-300/80"
        : "bg-rose-950/40 text-rose-300/70");
    span.dataset.tag = String(tagId);
    span.textContent = label;

    const drop = document.createElement("button");
    drop.type = "button";
    drop.className =
      "tag-drop cursor-pointer opacity-0 transition group-hover:opacity-60 hover:!opacity-100";
    drop.textContent = "✕";
    span.append(drop);
    return span;
  }

  function openEditor(row: HTMLElement, addButton: HTMLElement) {
    if (row.querySelector(".tag-editor")) return;

    const editor = document.createElement("span");
    editor.className = "tag-editor inline-flex items-center gap-1";

    const input = document.createElement("input");
    input.className =
      "w-36 rounded-full border border-gray-700 bg-transparent px-2 py-0.5 text-[11px] text-gray-200 outline-none focus:border-gray-500";
    input.maxLength = 60;

    const close = () => {
      editor.remove();
      addButton.classList.remove("hidden");
    };

    const submit = async (kind: "complaint" | "praise") => {
      const label = input.value.trim();
      if (label.length < 2) return close();

      const res = await fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ entryId: Number(row.dataset.entry), label, kind }),
      });
      const data = await res.json().catch(() => ({}));
      if (data.tag) row.insertBefore(chip(data.tag.id, data.tag.label, kind), editor);
      close();
    };

    for (const [kind, text] of [
      ["complaint", "\u2212"],
      ["praise", "+"],
    ] as const) {
      const button = document.createElement("button");
      button.type = "button";
      button.className =
        "cursor-pointer rounded-full border border-gray-700 px-1.5 py-0.5 text-[11px] text-gray-400 hover:border-gray-500 hover:text-gray-200";
      button.textContent = text;
      button.title = kind === "praise" ? "хвалю" : "ругаю";
      button.addEventListener("mousedown", (event) => {
        event.preventDefault();
        submit(kind);
      });
      editor.append(button);
    }

    editor.prepend(input);
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") submit(event.shiftKey ? "praise" : "complaint");
      if (event.key === "Escape") close();
    });
    input.addEventListener("blur", () => setTimeout(close, 120));

    addButton.classList.add("hidden");
    addButton.before(editor);
    input.focus();
  }

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const row = target.closest(".tag-row") as HTMLElement | null;
    if (!row) return;

    const drop = target.closest(".tag-drop");
    if (drop) {
      const tag = drop.closest("[data-tag]") as HTMLElement;
      tag.remove();
      fetch(ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "remove",
          entryId: Number(row.dataset.entry),
          tagId: Number(tag.dataset.tag),
        }),
      });
      return;
    }

    const add = target.closest(".tag-add") as HTMLElement | null;
    if (add) openEditor(row, add);
  });
</script>
