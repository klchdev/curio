---
import RichText from "../RichText";
import { TIER_STYLE, advisorHint, type AdvisorTier } from "../../lib/vocab";
import { DEFAULT_LOCALE, type Locale } from "../../lib/i18n";
import { t } from "../../lib/strings";

/**
 * One advice card, exactly as the hub draws it.
 *
 * The landing used to show a fan of cover art, which said "there are games in
 * here" and nothing else. The unit this product actually deals in is this card:
 * a tier, a title and a sentence explaining the choice through the person's own
 * diary. Showing one of those whole beats showing six covers half-hidden.
 *
 * A copy of the hub's hero markup rather than an import: that card is welded to
 * the hub's state — contracts, deep dives, the dice — and pulling it apart to
 * borrow the layout would mean surgery on a file three other things are moving
 * through. What must not drift is shared instead of copied: tier colours and
 * the tier's meaning come from `vocab.ts`, and the reason text goes through the
 * same `RichText` the app uses, so `**bold**` and `*Game Title*` render alike.
 *
 * No client directive on RichText on purpose — Astro renders it to static HTML
 * and the landing keeps shipping no JavaScript.
 */

interface Props {
  pick: {
    title: string;
    headerImage: string | null;
    tier: string;
    reason: string;
    hours: number;
  };
  locale?: Locale;
}

const { pick, locale = DEFAULT_LOCALE } = Astro.props;
const s = t(locale);

const tier = pick.tier as AdvisorTier;
const tone = TIER_STYLE[pick.tier as keyof typeof TIER_STYLE] ?? TIER_STYLE.B;
---

<!--
  The cover column grows with the viewport rather than staying fixed: a small
  cover next to a tall paragraph leaves the art floating in a void, which is
  exactly what the hub avoids by giving it 400px of the row.
-->
<div
  class="grid items-center gap-8 sm:grid-cols-[minmax(0,280px)_1fr] sm:gap-10 lg:grid-cols-[minmax(0,360px)_1fr]"
>
  <div class="relative">
    <!-- The glow is tinted by the tier: the colour is already the verdict -->
    <div class={`absolute -inset-4 rounded-3xl ${tone.bg} opacity-15 blur-2xl`}></div>
    {
      pick.headerImage && (
        <img
          src={pick.headerImage}
          alt={pick.title}
          width="460"
          height="215"
          class="relative w-full rounded-2xl shadow-2xl shadow-black/60"
        />
      )
    }
  </div>

  <div>
    <div class="mb-3 flex items-center gap-3">
      <span class={`text-5xl leading-none font-black ${tone.accent}`}>{pick.tier}</span>
      <span class="text-sm text-gray-500">
        {advisorHint(tier, locale)}<br />
        {pick.hours > 0 ? s.choose.playedHours(pick.hours) : s.choose.neverLaunched}
      </span>
    </div>

    <h3 class="mb-4 text-3xl leading-tight font-bold text-balance">{pick.title}</h3>

    <p class="text-base leading-relaxed text-gray-400">
      <RichText text={pick.reason} />
    </p>
  </div>
</div>
