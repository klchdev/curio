---
import { VARIANTS } from "../../pages/mockup/_data";

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<div class="sticky top-0 z-30 -mx-6 mb-6 border-b border-gray-800 bg-gray-950/90 px-6 py-3 backdrop-blur">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-2">
    <span class="mr-2 text-xs tracking-wide text-gray-600 uppercase">Макет</span>
    {VARIANTS.map((variant) => (
      <a
        href={`/mockup/${variant.slug}`}
        title={variant.hint}
        class:list={[
          "rounded-lg border px-3 py-1.5 text-sm whitespace-nowrap transition",
          variant.slug === current
            ? "border-emerald-600 bg-emerald-600/15 text-emerald-300"
            : "border-gray-800 text-gray-400 hover:bg-gray-800",
        ]}
      >
        {variant.name}
      </a>
    ))}
    <a href="/dashboard" class="ml-auto text-sm text-gray-500 transition hover:text-white">
      Текущий интерфейс &rarr;
    </a>
  </div>
</div>
