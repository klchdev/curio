---
import "../styles/global.css";
import { LOCALES, localeFrom } from "../lib/i18n";
import { t } from "../lib/strings";
import Analytics from "../components/Analytics.astro";

interface Props {
  title: string;
  /** Overrides the site-wide one. Only the landing page needs its own. */
  description?: string;
}

const { title, description } = Astro.props;
const locale = localeFrom(Astro.cookies, Astro.request);
const s = t(locale);

/*
 * A page that already carries the name keeps it as is: the dashboard passes
 * "Curio" and used to come out as "Curio | Curio".
 */
const fullTitle = title.includes("Curio") ? title : `${title} | Curio`;
const pageDescription = description ?? s.meta.description;

/*
 * The address as the visitor sees it. There is no `site` in the config — this
 * runs on whatever host it was deployed to — so the request's own origin is
 * the only truthful source for a canonical link and an og:url.
 */
const canonical = new URL(Astro.url.pathname, Astro.url.origin).href;

const OG_LOCALE = { ru: "ru_RU", en: "en_US" }[locale];

// Come back to where we already are: switching language must not drop you on the home page
const back = Astro.url.pathname + Astro.url.search;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#030712" />
    <title>{fullTitle}</title>

    <!--
      What a link to this page looks like when it is pasted into a chat or a
      forum thread — the only channels this thing spreads through. Without them
      a share renders as a bare URL and the name alone has to sell it.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Curio" />
    <meta property="og:locale" content={OG_LOCALE} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />

    {/* Renders nothing unless this is a public page and a counter id is configured */}
    <Analytics />
  </head>
  <body class="min-h-screen bg-gray-950 text-gray-100">
    <nav class="border-b border-gray-800 px-6 py-4">
      <div class="mx-auto flex max-w-5xl items-center justify-between">
        <a href="/" class="group flex items-center gap-2.5 text-xl font-bold text-white">
          <svg viewBox="0 0 32 32" class="h-7 w-7 text-gray-500 transition group-hover:text-gray-300" fill="none">
            <rect x="3.5" y="3.5" width="25" height="25" rx="6" stroke="currentColor" stroke-width="2" />
            <rect x="9" y="9" width="6" height="6" rx="1.5" class="fill-emerald-400" />
            <rect x="17" y="9" width="6" height="6" rx="1.5" fill="currentColor" opacity="0.35" />
            <rect x="9" y="17" width="6" height="6" rx="1.5" fill="currentColor" opacity="0.35" />
            <rect x="17" y="17" width="6" height="6" rx="1.5" fill="currentColor" opacity="0.35" />
          </svg>
          <span class="tracking-tight">Curio</span>
        </a>
        <div class="flex items-center gap-1 text-xs">
          {
            LOCALES.map((code) => (
              <a
                href={`/api/lang?to=${code}&back=${encodeURIComponent(back)}`}
                class={`rounded px-2 py-1 uppercase transition ${
                  code === locale ? "bg-gray-800 text-white" : "text-gray-600 hover:text-gray-300"
                }`}
              >
                {code}
              </a>
            ))
          }
        </div>
      </div>
    </nav>
    <main class="mx-auto max-w-5xl px-6 py-8">
      <slot />
    </main>
  </body>
</html>
