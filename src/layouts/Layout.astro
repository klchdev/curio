---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="BacklogRoulette — контракт с собой на прохождение Steam бэклога" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | BacklogRoulette</title>
  </head>
  <body class="min-h-screen bg-gray-950 text-gray-100">
    <nav class="border-b border-gray-800 px-6 py-4">
      <div class="mx-auto flex max-w-5xl items-center justify-between">
        <a href="/" class="text-xl font-bold text-white">🎰 BacklogRoulette</a>
        <div id="nav-user"></div>
      </div>
    </nav>
    <main class="mx-auto max-w-5xl px-6 py-8">
      <slot />
    </main>
  </body>
</html>
